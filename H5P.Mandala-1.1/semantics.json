[
  {
    "name": "title",
    "type": "text",
    "label": "Überschrift",
    "optional": true,
    "maxLength": 120
  },
  {
    "name": "description",
    "type": "text",
    "widget": "textarea",
    "label": "Aufgabenstellung",
    "optional": true,
    "maxLength": 2000
  },
  {
    "name": "image",
    "type": "image",
    "label": "Schwarz-Weiß-Bild (JPG oder PNG)",
    "description": "Geschlossene dunkle Konturen auf hellen Flächen verwenden. Nur JPG und PNG werden unterstützt."
  },
  {
    "name": "alt",
    "type": "text",
    "label": "Bildbeschreibung",
    "default": "Mandala",
    "maxLength": 300
  },
  {
    "name": "palette",
    "type": "list",
    "label": "Eigene Farbpalette (ergänzt die Standardfarben)",
    "optional": true,
    "entity": "Farbe",
    "min": 0,
    "max": 32,
    "field": {
      "name": "item",
      "type": "group",
      "label": "Farbe",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "label": "Farbname"
        },
        {
          "name": "color",
          "type": "text",
          "label": "Farbcode (#RRGGBB)",
          "default": "#e53935",
          "regexp": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "modifiers": ""
          },
          "widget": "mandalaColor"
        }
      ]
    }
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Einstellungen",
    "expanded": false,
    "fields": [
      {
        "name": "customColor",
        "type": "boolean",
        "label": "Freie Farbauswahl erlauben",
        "default": true
      },
      {
        "name": "download",
        "type": "boolean",
        "label": "PNG-Download erlauben",
        "default": true
      },
      {
        "name": "zoom",
        "type": "boolean",
        "label": "Zoom aktivieren",
        "default": true
      },
      {
        "name": "fullscreen",
        "type": "boolean",
        "label": "Vollbild aktivieren",
        "default": true
      },
      {
        "name": "finish",
        "type": "boolean",
        "label": "Fertig-Schaltfläche anzeigen (ohne Punkte)",
        "default": true
      },
      {
        "name": "threshold",
        "type": "number",
        "label": "Grenzwert für dunkle Konturen",
        "description": "Pixel bis zu diesem Helligkeitswert begrenzen die Fläche. Offene Konturen werden nicht geschlossen.",
        "min": 20,
        "max": 240,
        "default": 110,
        "decimals": 0
      },
      {
        "name": "maxSize",
        "type": "number",
        "label": "Maximale Bildkante der Arbeitskopie (Pixel)",
        "description": "Große Bilder werden intern verkleinert. Das hochgeladene Original bleibt im Paket.",
        "min": 256,
        "max": 2048,
        "default": 1536,
        "decimals": 0
      },
      {
        "name": "hideStandardColors",
        "type": "boolean",
        "label": "Standardfarben ausblenden",
        "optional": true,
        "default": false,
        "description": "Es erscheinen nur die eigenen Farben. Bei leerer Palette wird die freie Farbauswahl automatisch eingeschaltet."
      },
      {
        "name": "showColorValue",
        "type": "boolean",
        "label": "Aktiven RGB-Farbwert anzeigen",
        "optional": true,
        "default": false
      }
    ]
  },
  {
    "name": "l10n",
